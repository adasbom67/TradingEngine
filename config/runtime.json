{
  "environment": "paper",
  "version": "0.10.3",
  "logging": {
    "level": "INFO",
    "directory": "logs",
    "filename": "tradingengine.jsonl",
    "audit_filename": "audit.jsonl",
    "max_bytes": 5000000,
    "backup_count": 5
  },
  "paths": {
    "data_directory": "data",
    "reports_directory": "reports",
    "watchlist_file": "config/watchlists.json",
    "schedule_file": "config/schedule.json",
    "scheduler_state_file": "data/scheduler_state.json",
    "paper_ledger_file": "data/paper_account.json"
  },
  "risk": {
    "maximum_open_positions": 5,
    "maximum_risk_per_trade": 500.0,
    "maximum_committed_risk_percent": 5.0,
    "daily_loss_limit_percent": 2.0
  },
  "resilience": {
    "retry_attempts": 3,
    "retry_initial_delay_seconds": 0.5,
    "retry_backoff_multiplier": 2.0,
    "retry_maximum_delay_seconds": 5.0,
    "instance_lock_file": "data/tradingengine.lock",
    "recovery_checkpoint_file": "data/recovery_checkpoint.json"
  },
  "trading": {
    "execution_mode": "dry_run",
    "approved_symbols": [
      "SPY",
      "QQQ",
      "IWM",
      "DIA"
    ],
    "live_submission_enabled": false
  },
  "paper_trading": {
    "initial_cash": 100000.0,
    "ledger_file": "data/paper_account.json",
    "capital_source": "fixed"
  }
}
